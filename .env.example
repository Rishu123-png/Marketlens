# ==================================================
# MARKETLENS SERVER ENVIRONMENT VARIABLES
# ==================================================

# Optional shared rate-limit store (Upstash Redis REST).
# Without these values, rate limits are best-effort per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IMPORTANT:
# Add the real values in Vercel Environment Variables.
# Do NOT put real API keys in src/main.jsx or any VITE_* variable.
# Never commit your real keys to GitHub.


# Financial Modeling Prep
FMP_API_KEY=


# Twelve Data
TWELVE_DATA_API_KEY=


# Alpha Vantage
ALPHA_VANTAGE_API_KEY=


# Finnhub (global-market fallback) — RETIREMENT CANDIDATE, see
# docs/architecture/environment-audit.md. Used only by the legacy /api/finnhub
# route; not used by research. Do not delete until that route is retired.
FINNHUB_API_KEY=


# Groq AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# AI runtime policy (see server/ai/config.js)
# Per-agent model override, e.g. AI_MODEL_TECHNICAL=...
AI_TIMEOUT_MS=20000
AI_RETRIES=1
AI_BACKOFF_MS=400
# Groq tool calling: application-executed, read-only tools over the run envelope.
# AI_TOOL_CALLING=off disables it; AI_TOOL_AGENTS overrides the default set.
AI_TOOL_CALLING=on
AI_TOOL_AGENTS=chart,news,sentiment


# Primary market provider
# Allowed values:
# fmp
# twelve
# alpha
PRIMARY_MARKET_PROVIDER=fmp

# ==================================================
# NEWS & FILINGS INTELLIGENCE
# ==================================================
# NewsAPI.org search (optional third-party fallback)
NEWS_API_KEY=
# GNews search
GNEWS_API_KEY=
# Order of news providers, e.g. newsapi,gnews,official-rss
NEWS_PROVIDER_ORDER=
# Official RBI/SEBI/PIB feeds are polled by default. NEWS_RSS_ENABLED=off
# disables all feed polling (coverage will report news as unavailable).
NEWS_RSS_ENABLED=on
# Operator-supplied RSS/Atom feeds: "Publisher|https://example.com/feed.xml"
# Separate multiple entries with a semicolon or a newline.
NEWS_RSS_FEEDS=
# Official BSE RSS for corporate announcements / results / board meetings.
# BSE publishes these feeds; supply the exact URL from beta.bseindia.com/rss-feed.html.
BSE_ANNOUNCEMENTS_RSS=
# NSE announcements feed: only with NSE's written permission. Off by default
# because NSE's terms prohibit automated collection without consent.
NSE_ANNOUNCEMENTS_RSS=

# NSE corporate announcements via browser session cookie — RETIREMENT CANDIDATE.
# Legally fragile; leave empty unless you hold an NSE licence covering it.
NSE_FILINGS_COOKIE=
# BSE internal API adapter is intentionally disabled — RETIREMENT CANDIDATE.
# Use BSE_ANNOUNCEMENTS_RSS instead.
BSE_FILINGS_ENABLED=false

# Official evidence sources
# SEC EDGAR requires a descriptive User-Agent with a contact email, e.g.
# "MarketLens/1.0 (ops@example.com)". Without it, US filings are unavailable.
SEC_USER_AGENT=
# data.gov.in OGD key (optional; macro/reference datasets only, never prices).
DATA_GOV_IN_API_KEY=


# ==================================================
# DURABLE EXECUTION (O1)
# ==================================================
# Upstash QStash: the API publishes a job id and an independent worker runs it.
QSTASH_TOKEN=
# Public URL of the worker deployment, e.g. https://worker.example.com/api/worker
WORKER_URL=
# Mandatory shared secret for POST /api/worker. Generate a long random value.
WORKER_SECRET=
# Poll interval for `npm run worker`
WORKER_POLL_MS=2000


# ==================================================
# STORAGE
# ==================================================
# PostgreSQL connection string. Without it, jobs live in process memory only.
DATABASE_URL=
DATABASE_POOL_MAX=5
# require | no-verify | (empty = no TLS)
DATABASE_SSL=
# Local object-store root (report artefacts)
OBJECT_STORE_ROOT=.data/objects

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, ...)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional second market-data provider used for the independent price cross-check
# e.g. twelve or alpha
SECONDARY_MARKET_PROVIDER=
