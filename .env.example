# ==================================================
# MARKETLENS SERVER ENVIRONMENT VARIABLES
# ==================================================

# Optional shared rate-limit store (Upstash Redis REST).
# Without these values, rate limits are best-effort per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IMPORTANT:
# Add the real values in Vercel Environment Variables.
# Do NOT put real API keys in src/main.jsx or any VITE_* variable.
# Never commit your real keys to GitHub.


# Financial Modeling Prep
FMP_API_KEY=


# Twelve Data
TWELVE_DATA_API_KEY=


# Alpha Vantage
ALPHA_VANTAGE_API_KEY=


# News provider
NEWS_API_KEY=


# Finnhub (global-market fallback)
FINNHUB_API_KEY=


# Groq AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# AI runtime policy (see server/ai/config.js)
# Per-agent model override, e.g. AI_MODEL_TECHNICAL=...
AI_TIMEOUT_MS=20000
AI_RETRIES=1
AI_BACKOFF_MS=400


# Primary market provider
# Allowed values:
# fmp
# twelve
# alpha
PRIMARY_MARKET_PROVIDER=fmp

# ==================================================
# NEWS & FILINGS INTELLIGENCE
# ==================================================
# NewsAPI.org search
NEWS_API_KEY=
# GNews search
GNEWS_API_KEY=
# Order of news providers, e.g. newsapi,gnews,official-rss
NEWS_PROVIDER_ORDER=
# Verified RSS/Atom feeds only: "Publisher|https://example.com/feed.xml"
# Separate multiple entries with a semicolon or a newline.
NEWS_RSS_FEEDS=

# NSE corporate announcements require a browser session cookie and exchange
# terms that restrict automated use. Leave empty unless you have verified both.
NSE_FILINGS_COOKIE=
# BSE announcements additionally need a scrip-code mapping; adapter is disabled.
BSE_FILINGS_ENABLED=false


# ==================================================
# DURABLE EXECUTION (O1)
# ==================================================
# Upstash QStash: the API publishes a job id and an independent worker runs it.
QSTASH_TOKEN=
# Public URL of the worker deployment, e.g. https://worker.example.com/api/worker
WORKER_URL=
# Mandatory shared secret for POST /api/worker. Generate a long random value.
WORKER_SECRET=
# Poll interval for `npm run worker`
WORKER_POLL_MS=2000


# ==================================================
# STORAGE
# ==================================================
# PostgreSQL connection string. Without it, jobs live in process memory only.
DATABASE_URL=
DATABASE_POOL_MAX=5
# require | no-verify | (empty = no TLS)
DATABASE_SSL=
# Local object-store root (report artefacts)
OBJECT_STORE_ROOT=.data/objects

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, ...)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional second market-data provider used for the independent price cross-check
# e.g. twelve or alpha
SECONDARY_MARKET_PROVIDER=
